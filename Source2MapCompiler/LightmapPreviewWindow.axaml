<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Source2MapCompiler"
        x:Class="Source2MapCompiler.LightmapPreviewWindow"
        Title="Lightmap Preview"
        Icon="avares://Source2MapCompiler/assets/icon.ico"
        Width="900" Height="900"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBrush}"
        local:WindowAccent.Color="{DynamicResource AccentColor}">
    <Panel>
        <local:DitheredGradient CenterColor="{DynamicResource AppAccentColor}" EdgeColor="{DynamicResource AppColor}" GradientOrigin="90%,0%" />

        <DockPanel Margin="8">
            <!-- what is being baked, and how far it is -->
            <TextBlock Name="Status" DockPanel.Dock="Bottom" Margin="4,8,4,0" TextWrapping="Wrap" Foreground="{DynamicResource ContrastBrush}" Text="Waiting for vrad3 to start baking..." />

            <Border DockPanel.Dock="Top" Margin="0,0,0,8" Background="{DynamicResource ShadeBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Content="Fit" Click="OnFit" ToolTip.Tip="Fit the whole lightmap into view, or double click it" />
                        <Button Name="SaveButton" Content="Save image" Click="OnSave" IsEnabled="False" ToolTip.Tip="Save the lightmap as it is shown to a PNG" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <CheckBox Name="BlocksBox" Content="Blocks" IsChecked="True" ToolTip.Tip="Outline the blocks vrad3 bakes the lightmap in" />
                        <TextBlock Text="Exposure" VerticalAlignment="Center" Foreground="{DynamicResource ContrastBrush}" />
                        <Slider Name="ExposureSlider" ToolTip.Tip="Stops brighter or darker than the auto exposure, which shows the lightmap's average brightness as middle grey" Width="180" Minimum="-8" Maximum="8" Value="0" SmallChange="0.5" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="False" VerticalAlignment="Center" />
                        <TextBlock Name="ExposureLabel" Width="40" Text="0.0" VerticalAlignment="Center" Foreground="{DynamicResource ContrastSoftBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True">
                <local:LightmapView Name="View" ShowBlocks="{Binding #BlocksBox.IsChecked}" />
            </Border>
        </DockPanel>
    </Panel>
</Window>
