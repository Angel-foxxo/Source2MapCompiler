<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Source2MapCompiler"
        xmlns:ae="using:AvaloniaEdit"
        xmlns:sp="using:ScottPlot.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="900"
        x:Class="Source2MapCompiler.MainWindow"
        Title="Source2 Map Compiler"
        Icon="avares://Source2MapCompiler/assets/icon.ico"
        Width="1280" Height="900"
        MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBrush}"
        local:WindowAccent.Color="{DynamicResource AccentColor}">
    <Window.Resources>
        <!-- the status pills: a tint of the accent for what was found, of red for what was not -->
        <SolidColorBrush x:Key="FoundPillBrush" Color="{DynamicResource AccentColor}" Opacity="0.45" />
        <SolidColorBrush x:Key="MissingPillBrush" Color="{DynamicResource DangerAccentColor}" Opacity="0.35" />
        <SolidColorBrush x:Key="ErrorTextBrush" Color="{DynamicResource DangerAccentColor}" />
    </Window.Resources>

    <Window.Styles>
        <!-- toolbar buttons: icon over label, like the workshop manager's -->
        <Style Selector=":is(Button).tool">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinWidth" Value="52" />
            <Setter Property="Background" Value="{DynamicResource ShadeBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector=":is(Button).tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
        </Style>
        <Style Selector=":is(Button).tool:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- a tool that can not be used now is faded, icon and all -->
        <Style Selector=":is(Button).tool:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector=":is(Button).tool StackPanel">
            <Setter Property="Spacing" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector=":is(Button).tool Image">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
        </Style>
        <Style Selector=":is(Button).tool TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ContrastBrush}" />
        </Style>
        <Style Selector=":is(Button).tool:pressed TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>

        <!-- the option groups: panels that shade the gradient, like the workshop manager's -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource ShadeBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ContrastBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{DynamicResource ContrastBrush}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource ContrastSoftBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="SelectableTextBlock.value">
            <Setter Property="Foreground" Value="{DynamicResource ContrastSoftBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.card CheckBox">
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <!-- an option with a description under it, spaced so each reads as one item -->
        <Style Selector="CheckBox.described">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style Selector="Border.card ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <!-- thread counts: whole numbers from one up to the threads there are, clamped back into that range -->
        <Style Selector="NumericUpDown.threads">
            <Setter Property="Minimum" Value="1" />
            <Setter Property="Increment" Value="1" />
            <Setter Property="FormatString" Value="0" />
            <Setter Property="ParsingNumberStyle" Value="Integer" />
            <Setter Property="ClipValueToMinMax" Value="True" />
            <Setter Property="Margin" Value="0,2" />
        </Style>
        <!-- Fluent puts the arrows side by side as two wide buttons, here they are small and stacked like a classic spin box -->
        <Style Selector="NumericUpDown.threads /template/ ButtonSpinner /template/ StackPanel#PART_SpinnerPanel">
            <Setter Property="Orientation" Value="Vertical" />
        </Style>
        <Style Selector="NumericUpDown.threads /template/ ButtonSpinner /template/ RepeatButton">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="15" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
        </Style>
        <Style Selector="NumericUpDown.threads /template/ ButtonSpinner /template/ RepeatButton PathIcon">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="4" />
        </Style>
        <Style Selector="NumericUpDown.threads /template/ ButtonSpinner /template/ RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="NumericUpDown.threads /template/ ButtonSpinner /template/ RepeatButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <!-- an arrow that can not step further, at the minimum or the maximum, keeps its face and stays plainly visible -->
        <Style Selector="NumericUpDown.threads /template/ ButtonSpinner /template/ RepeatButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ContrastSoftBrush}" />
        </Style>
        <!-- a stage's card header, its name and the switch that turns the stage on or off -->
        <Style Selector="DockPanel.stage">
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="DockPanel.stage TextBlock.heading">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="DockPanel.stage ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Border.card:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <!-- a choice of a few values, all of them shown, the chosen one in the accent -->
        <Style Selector="ListBox.segmented">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ContrastBrush}" />
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlHoverBrush}" />
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
        </Style>

        <!-- debug and advanced options, folded away under a plain header -->
        <Style Selector="Expander.debug">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Expander.debug /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource ContrastSoftBrush}" />
        </Style>
        <Style Selector="Expander.debug /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Expander.debug /template/ Border#ExpanderContent">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!-- pills: whether the game and its tools were found -->
        <Style Selector="Border.pill">
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource ContrastBrush}" />
        </Style>
        <Style Selector="Border.pill.found">
            <Setter Property="Background" Value="{DynamicResource FoundPillBrush}" />
        </Style>
        <Style Selector="Border.pill.missing">
            <Setter Property="Background" Value="{DynamicResource MissingPillBrush}" />
        </Style>

    </Window.Styles>

    <Panel>
        <!-- window background: a subtle glow of the accent fading to the main colour, dithered so it does not band -->
        <local:DitheredGradient CenterColor="{DynamicResource AppAccentColor}" EdgeColor="{DynamicResource AppColor}" GradientOrigin="90%,0%" />

        <DockPanel>
            <!-- how the compile is going -->
            <DockPanel DockPanel.Dock="Bottom" Margin="12,4,12,8">
                <!-- how far the compile has got, while it runs -->
                <ProgressBar Name="compileBar" DockPanel.Dock="Right" Width="320" Margin="12,0,0,0" Maximum="100" ShowProgressText="True" VerticalAlignment="Center" IsVisible="False" />
                <TextBlock Name="statusLabel" Text="Ready" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ContrastBrush}" />
            </DockPanel>

            <!-- the compile's actions, whether the game and tools are there, and the settings -->
            <Grid DockPanel.Dock="Top" Margin="8,6" ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Name="button1" Classes="tool" Tag="labelCompile" Click="button1_Click">
                        <StackPanel>
                            <Image Source="avares://Source2MapCompiler/assets/buttons/compile.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                            <TextBlock Text="Compile" />
                        </StackPanel>
                    </Button>
                    <Button Name="button2" Classes="tool" Tag="labelCancel" Click="button2_Click">
                        <StackPanel>
                            <Image Source="avares://Source2MapCompiler/assets/buttons/cancel.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                            <TextBlock Text="Cancel" />
                        </StackPanel>
                    </Button>
                    <Button Name="button4" Classes="tool" Tag="labelopenvmap" Click="button4_Click">
                        <StackPanel>
                            <Image Source="avares://Source2MapCompiler/assets/buttons/open.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                            <TextBlock Text="Open .vmap" />
                        </StackPanel>
                    </Button>
                    <Button Name="button5" Classes="tool" Tag="labeloverrideoutput" IsEnabled="False" Click="button5_Click">
                        <StackPanel>
                            <Image Source="avares://Source2MapCompiler/assets/buttons/output.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                            <TextBlock Text="Change Output" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="Game" VerticalAlignment="Center" Foreground="{DynamicResource ContrastSoftBrush}" />
                    <ComboBox Name="gameList" Tag="labelgamestatus" PlaceholderText="Not Found" MinWidth="160" VerticalAlignment="Center" SelectionChanged="OnGameChanged" />
                    <Button Name="button3" Tag="labelCustomPath" Content="Custom path" VerticalAlignment="Center" Click="button3_Click" />
                    <TextBlock Text="Tools" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource ContrastSoftBrush}" />
                    <Border Name="wststatusPill" Classes="pill missing">
                        <TextBlock Name="wststatus" Tag="labeltoolstatus" Text="Not Found" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="3" Classes="tool" Click="OnSettings">
                    <StackPanel>
                        <Image Source="avares://Source2MapCompiler/assets/buttons/settings.png" RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Margin="8,0" ColumnDefinitions="620,8,*">
                <!-- the options: a preset, then the cards CompileOptions defines, filled in by the window -->
                <ScrollViewer>
                    <StackPanel Spacing="8" Margin="0,0,14,8">
                        <Border Classes="card">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                        <CheckBox Name="lockProfileBox" Content="Locked" Click="OnLockProfile" IsEnabled="False" Margin="0,0,8,0" ToolTip.Tip="While the profile is locked, changing an option moves to Custom instead of changing the profile" ToolTip.ShowOnDisabled="True" />
                                        <Button Content="New profile" Click="OnNewProfile" ToolTip.Tip="Save the options as they are now as a profile every map can use. It starts locked" />
                                        <Button Name="renameProfileButton" Content="Rename" Click="OnRenameProfile" IsEnabled="False" ToolTip.Tip="Rename the profile that's picked" ToolTip.ShowOnDisabled="True" />
                                        <Button Name="deleteProfileButton" Content="Delete" Click="OnDeleteProfile" IsEnabled="False" ToolTip.Tip="Delete the profile that's picked" ToolTip.ShowOnDisabled="True" />
                                    </StackPanel>
                                    <TextBlock Classes="heading" Text="Preset" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                                <!-- the built in presets and Custom fill the first row, the user's profiles wrap onto more -->
                                <ListBox Name="presetList" Classes="segmented" Margin="0,8,0,0">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="5" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Margin" Value="0,0,4,4" />
                                        </Style>
                                    </ListBox.Styles>
                                </ListBox>
                                <TextBlock Name="presetNote" Classes="note" Margin="0,4,0,2" />
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,8,*">
                            <StackPanel Name="leftColumn" Spacing="8" />
                            <StackPanel Name="rightColumn" Grid.Column="2" Spacing="8" />
                        </Grid>

                        <StackPanel Name="bottomColumn" Spacing="8" />
                    </StackPanel>
                </ScrollViewer>

                <!-- what is compiled where, with what, and what it says -->
                <DockPanel Grid.Column="2" Margin="0,0,0,8">
                    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,4,Auto,10,Auto,Auto">
                            <TextBlock Classes="label" Text="Map:" />
                            <SelectableTextBlock Name="mapLabel" Grid.Column="1" Classes="value" Text="N/A" TextWrapping="NoWrap" TextTrimming="PathSegmentEllipsis" />

                            <TextBlock Grid.Row="2" Classes="label" Text="Output:" />
                            <SelectableTextBlock Name="outputdir" Grid.Row="2" Grid.Column="1" Classes="value" Text="N/A" TextWrapping="NoWrap" TextTrimming="PathSegmentEllipsis" />

                            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Classes="heading" Text="Command line" />
                            <SelectableTextBlock Name="cmdLine" Grid.Row="5" Grid.ColumnSpan="2" Classes="value" Text="N/A" FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="12" />
                        </Grid>
                    </Border>

                    <!-- how busy the machine is over the last minute, drawn by ScottPlot -->
                    <Grid Name="resourceGraphs" DockPanel.Dock="Bottom" ColumnDefinitions="*,8,*,8,*" Height="110" Margin="0,8,0,0" IsVisible="False">
                        <Grid.Styles>
                            <Style Selector="Grid#resourceGraphs > Border > DockPanel > TextBlock">
                                <Setter Property="DockPanel.Dock" Value="Top" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Foreground" Value="{DynamicResource ContrastBrush}" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Grid.Styles>
                        <Border Classes="card" ToolTip.Tip="How busy the CPU is, all of its cores together">
                            <DockPanel>
                                <TextBlock Name="cpuTitle" Text="CPU" />
                                <sp:AvaPlot Name="cpuGraph" />
                            </DockPanel>
                        </Border>
                        <Border Name="gpuCard" Grid.Column="2" Classes="card" ToolTip.Tip="How busy the GPU is and how much of its memory is in use">
                            <DockPanel>
                                <TextBlock Name="gpuTitle" Text="GPU" />
                                <sp:AvaPlot Name="gpuGraph" />
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="4" Classes="card" ToolTip.Tip="How much of the memory is in use">
                            <DockPanel>
                                <TextBlock Name="memoryTitle" Text="Memory" />
                                <sp:AvaPlot Name="memoryGraph" />
                            </DockPanel>
                        </Border>
                       
                    </Grid>

                    <Border Classes="card">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                                    <Button Name="lightmapPreviewButton" Content="Lightmap preview" Click="OnShowLightmapPreview" IsEnabled="False" ToolTip.Tip="Open the lightmap preview again, showing the bake as it goes or the last one" ToolTip.ShowOnDisabled="True" />
                                    <Button Content="Copy" Click="OnCopyLog" ToolTip.Tip="Copy the selected text, or the whole log when nothing is selected" />
                                    <Button Content="Clear" Click="OnClearLog" />
                                </StackPanel>
                                <TextBlock Classes="heading" Text="Compile log" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <!-- read only text, selected and copied like in any editor, its lines coloured by what they report -->
                            <Border Background="{DynamicResource FieldBrush}" CornerRadius="4" ClipToBounds="True">
                                <ae:TextEditor Name="logEditor" IsReadOnly="True" WordWrap="True" ShowLineNumbers="False" Padding="8,4"
                                               FontFamily="Cascadia Mono,Consolas,Menlo,monospace" FontSize="13"
                                               Background="Transparent" Foreground="{DynamicResource LogTextBrush}"
                                               HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ae:TextEditor.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy" InputGesture="Ctrl+C" Click="OnCopySelectedLog" />
                                            <MenuItem Header="Copy all" Click="OnCopyAllLog" />
                                            <Separator />
                                            <MenuItem Header="Select all" InputGesture="Ctrl+A" Click="OnSelectAllLog" />
                                        </ContextMenu>
                                    </ae:TextEditor.ContextMenu>
                                </ae:TextEditor>
                            </Border>
                        </DockPanel>
                    </Border>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Panel>
</Window>
