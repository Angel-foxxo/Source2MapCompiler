<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>A live view of the lightmap vrad3 is baking on the GPU, read out of the running vrad3 process.</Description>
    <AssemblyName>Source2MapCompiler.LightmapPreview</AssemblyName>
    <RootNamespace>Source2MapCompiler.LightmapPreview</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Iced" Version="1.21.0" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.346">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="TinyEXR.NET" Version="1.2.0" />
  </ItemGroup>
</Project>
